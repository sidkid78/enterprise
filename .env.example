# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and publishable key. Both are sent to the browser (NEXT_PUBLIC_),
# which is expected — RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. Bypasses RLS completely. Server-side only — never prefix
# this with NEXT_PUBLIC_ and never import src/lib/supabase/service.ts from a
# Client Component.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Gemini (phase 4 — agent runtime)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
